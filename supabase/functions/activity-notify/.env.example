# ── activity-notify — secrets & setup checklist ──────────────────────────────
# Copy the values, then run the `supabase secrets set ...` command at the bottom.
# These are FUNCTION secrets (server-side) — do NOT commit real values.

# Resend API key from resend.com (account: imaarishasrhr@gmail.com) → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where alerts are sent (the account's own address needs no verification)
ALERT_TO=imaarishasrhr@gmail.com

# Sender. Leave as-is until imaarishasrhr.org is verified in Resend, then switch
# to: "Imaarisha Hub <alerts@imaarishasrhr.org>"
ALERT_FROM=Imaarisha Hub <onboarding@resend.dev>

# Shared secret — must match the x-webhook-secret header on each DB webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Link used in the email's "Open the Hub" button
HUB_URL=https://hub.imaarishasrhr.org


# ── 1. Set the secrets (run once, from the repo root) ────────────────────────
# supabase secrets set \
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx \
#   ALERT_TO=imaarishasrhr@gmail.com \
#   ALERT_FROM="Imaarisha Hub <onboarding@resend.dev>" \
#   WEBHOOK_SECRET=change-me-to-a-long-random-string \
#   HUB_URL=https://hub.imaarishasrhr.org

# ── 2. Deploy the function ───────────────────────────────────────────────────
# supabase functions deploy activity-notify --no-verify-jwt
# URL: https://uwxtqyqyrhhxqagaqelg.functions.supabase.co/activity-notify

# ── 3. Create Database Webhooks (Supabase → Database → Webhooks) ─────────────
# One hook per table below — all identical except the table:
#   Tables : public.activity_log , public.fika_reviews , public.fika_suggestions
#            (optional: public.uliza_questions)
#   Events : Insert
#   Type   : HTTP Request · POST
#   URL    : the function URL above
#   Header : x-webhook-secret = <same WEBHOOK_SECRET as above>

# ── 4. Test (SQL editor) ─────────────────────────────────────────────────────
# insert into public.activity_log (activity_type, description, dot_color)
# values ('test', 'Email alert test', 'gold');
#   → expect an email at imaarishasrhr@gmail.com within seconds.
#   → if nothing arrives, check the function logs (most issues = unset key).
